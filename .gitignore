# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/

# ---------- Model weights (large; not committed; distributed separately) ----------
*.pth
*.pt
*.dat
*.ckpt
*.onnx

# ---------- Runtime artifacts / user data (private; never commit) ----------
user_upload_images/
output_img/
admin_data/
runs/
logs/
*.log

# ---------- Credentials (never commit) ----------
config/users.yaml
*.pem
*.key
.env
.env.*
# Temp files and file locks produced by atomic writes
*.yaml.tmp
*.yaml.lock
config/*.lock

# ---------- IDE / system ----------
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ---------- Tool directories ----------
.arts/
.codeartsdoer/
.workbuddy/

# ---------- Smoke tests / temporary artifacts (do not commit) ----------
test_images/gpu_smoke_*/
test_images/detect_smoke_out/
examples/bi_li_daxiao.py
