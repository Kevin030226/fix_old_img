# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
# Anchored for the same reason as the runtime-artifact block below.
build/
/dist/
*.egg-info/
.venv/
/venv/
/env/

# ---------- Model weights (large; not committed; distributed separately) ----------
*.pth
*.pt
*.dat
*.ckpt
*.onnx

# ---------- Runtime artifacts / user data (private; never commit) ----------
# Every entry in this block is anchored with a leading slash, and that is load
# bearing rather than tidiness. An unanchored `storage/` matches a directory of
# that name at ANY depth, so it silently excluded src/fiximg/infrastructure/
# storage/ -- base.py, s3.py and the package __init__ that defines
# fetch_to_local, publish_local_file, purge_expired_published and
# get_artifact_store. The commit passed its own type check, because the files
# were on disk; it failed on CI, where they are genuinely absent. Nothing
# reported it until mypy ran on a clean checkout.
# tests/unit/test_ignore_files.py now fails when a .py file under src/ or
# tests/ is untracked, which is the general form of this defect.
/user_upload_images/
/output_img/
/admin_data/
/runs/
/logs/
*.log
# V2 task storage: <year>/<month>/<task_id>/{input,stages,output}
# Holds user-uploaded photos and their restored results — never commit.
/storage/
/output/
# Upstream training logs left inside the checkpoint tree by the weights download
Global/checkpoints/**/*.txt

# ---------- Credentials (never commit) ----------
config/users.yaml
*.pem
*.key
.env
.env.*
# Temp files and file locks produced by atomic writes
*.yaml.tmp
*.yaml.lock
config/*.lock
# Stray HTTP responses / API dumps accidentally saved at the repo root
dd_api.json
hf_api.json

# ---------- IDE / system ----------
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ---------- Tool directories ----------
.arts/
.codeartsdoer/
.workbuddy/
# WorkBuddy project data (agent memory/logs; contains local paths — keep local)
.workbuddy-ai/
.freebuff/
# Tool caches (they also self-ignore, but be explicit)
.pytest_cache/
.ruff_cache/
# mypy was missing from this list while every other tool cache was named, which is
# how 123 MB of cache became stageable. `tests/unit/test_ignore_files.py` now
# requires the two ignore lists to agree on what must never be shipped.
.mypy_cache/

# ---------- Smoke tests / temporary artifacts (do not commit) ----------
test_images/gpu_smoke_*/
test_images/detect_smoke_out/
.gates/
examples/bi_li_daxiao.py
