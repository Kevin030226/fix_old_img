{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "metadata": {
    "name": "FixOldImg Design Tokens",
    "version": "1.0.0",
    "description": "Three-layer token architecture for old photo restoration system"
  },
  
  "primitive": {
    "color": {
      "slate": {
        "50": "#f8fafc",
        "100": "#f1f5f9",
        "200": "#e2e8f0",
        "300": "#cbd5e1",
        "400": "#94a3b8",
        "500": "#64748b",
        "600": "#475569",
        "700": "#334155",
        "800": "#1e293b",
        "900": "#0f172a",
        "950": "#020617"
      },
      "orange": {
        "50": "#fff7ed",
        "100": "#ffedd5",
        "200": "#fed7aa",
        "300": "#fdba74",
        "400": "#fb923c",
        "500": "#f97316",
        "600": "#ea580c",
        "700": "#c2410c",
        "800": "#9a3412",
        "900": "#7c2d12"
      },
      "green": {
        "50": "#f0fdf4",
        "100": "#dcfce7",
        "200": "#bbf7d0",
        "300": "#86efac",
        "400": "#4ade80",
        "500": "#22c55e",
        "600": "#16a34a",
        "700": "#15803d",
        "800": "#166534",
        "900": "#14532d"
      },
      "red": {
        "50": "#fef2f2",
        "100": "#fee2e2",
        "200": "#fecaca",
        "300": "#fca5a5",
        "400": "#f87171",
        "500": "#ef4444",
        "600": "#dc2626",
        "700": "#b91c1c",
        "800": "#991b1b",
        "900": "#7f1d1d"
      },
      "zinc": {
        "50": "#fafafa",
        "100": "#f4f4f5",
        "200": "#e4e4e7",
        "300": "#d4d4d8",
        "400": "#a1a1aa",
        "500": "#71717a",
        "600": "#52525b",
        "700": "#3f3f46",
        "800": "#27272a",
        "900": "#18181b",
        "950": "#09090b"
      }
    },
    "spacing": {
      "0": "0px",
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "7": "28px",
      "8": "32px",
      "9": "36px",
      "10": "40px"
    },
    "fontSize": {
      "xs": "12px",
      "sm": "13px",
      "base": "14px",
      "md": "15px",
      "lg": "18px",
      "xl": "20px",
      "2xl": "22px"
    },
    "fontWeight": {
      "normal": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    },
    "lineHeight": {
      "tight": "1.35",
      "snug": "1.4",
      "normal": "1.5",
      "relaxed": "1.6"
    },
    "borderRadius": {
      "none": "0",
      "sm": "6px",
      "md": "8px",
      "lg": "12px",
      "full": "999px"
    },
    "boxShadow": {
      "sm": "0 1px 2px rgba(0,0,0,.3)",
      "md": "0 16px 40px rgba(0,0,0,.45)",
      "combined": "0 1px 2px rgba(0,0,0,.3), 0 16px 40px rgba(0,0,0,.45)",
      "focus": "0 0 0 3px rgba(251,146,60,.25)"
    },
    "transition": {
      "fast": "0.15s",
      "normal": "0.2s",
      "slow": "0.3s"
    }
  },

  "semantic": {
    "color": {
      "background": {
        "primary": "{primitive.color.slate.950}",
        "secondary": "{primitive.color.zinc.800}",
        "tertiary": "{primitive.color.slate.800}",
        "elevated": "{primitive.color.zinc.700}",
        "overlay": "rgba(0,0,0,0.5)"
      },
      "foreground": {
        "primary": "{primitive.color.zinc.100}",
        "secondary": "{primitive.color.zinc.200}",
        "muted": "{primitive.color.zinc.500}",
        "inverse": "{primitive.color.slate.950}"
      },
      "border": {
        "default": "{primitive.color.zinc.700}",
        "subtle": "{primitive.color.zinc.600}",
        "strong": "{primitive.color.slate.500}",
        "focus": "{primitive.color.orange.400}"
      },
      "status": {
        "success": {
          "bg": "{primitive.color.green.900}",
          "fg": "{primitive.color.green.300}",
          "border": "{primitive.color.green.700}"
        },
        "error": {
          "bg": "{primitive.color.red.900}",
          "fg": "{primitive.color.red.200}",
          "border": "{primitive.color.red.700}"
        },
        "warning": {
          "bg": "{primitive.color.orange.900}",
          "fg": "{primitive.color.orange.300}",
          "border": "{primitive.color.orange.700}"
        },
        "info": {
          "bg": "{primitive.color.slate.800}",
          "fg": "{primitive.color.slate.200}",
          "border": "{primitive.color.slate.600}"
        }
      },
      "interactive": {
        "primary": {
          "default": "{primitive.color.orange.600}",
          "hover": "{primitive.color.orange.700}",
          "active": "{primitive.color.orange.800}",
          "disabled": "{primitive.color.zinc.700}"
        },
        "secondary": {
          "default": "transparent",
          "hover": "{primitive.color.zinc.700}",
          "active": "{primitive.color.zinc.600}",
          "disabled": "{primitive.color.zinc.800}"
        },
        "destructive": {
          "default": "{primitive.color.red.600}",
          "hover": "{primitive.color.red.700}",
          "active": "{primitive.color.red.800}",
          "disabled": "{primitive.color.zinc.700}"
        }
      }
    },
    "spacing": {
      "component": {
        "paddingX": "{primitive.spacing.3}",
        "paddingY": "{primitive.spacing.2}",
        "gap": "{primitive.spacing.2}"
      },
      "section": {
        "paddingX": "{primitive.spacing.7}",
        "paddingY": "{primitive.spacing.7}",
        "gap": "{primitive.spacing.5}"
      },
      "page": {
        "paddingX": "{primitive.spacing.8}",
        "paddingY": "{primitive.spacing.8}",
        "maxWidth": "440px"
      }
    },
    "typography": {
      "heading": {
        "brand": {
          "fontSize": "{primitive.fontSize.2xl}",
          "fontWeight": "{primitive.fontWeight.bold}",
          "lineHeight": "{primitive.lineHeight.tight}",
          "color": "{semantic.color.foreground.primary}"
        },
        "section": {
          "fontSize": "{primitive.fontSize.xl}",
          "fontWeight": "{primitive.fontWeight.bold}",
          "lineHeight": "{primitive.lineHeight.snug}",
          "color": "{semantic.color.foreground.primary}"
        },
        "subsection": {
          "fontSize": "{primitive.fontSize.lg}",
          "fontWeight": "{primitive.fontWeight.semibold}",
          "lineHeight": "{primitive.lineHeight.snug}",
          "color": "{semantic.color.foreground.primary}"
        }
      },
      "body": {
        "default": {
          "fontSize": "{primitive.fontSize.md}",
          "fontWeight": "{primitive.fontWeight.normal}",
          "lineHeight": "{primitive.lineHeight.normal}",
          "color": "{semantic.color.foreground.primary}"
        },
        "secondary": {
          "fontSize": "{primitive.fontSize.base}",
          "fontWeight": "{primitive.fontWeight.normal}",
          "lineHeight": "{primitive.lineHeight.relaxed}",
          "color": "{semantic.color.foreground.muted}"
        },
        "label": {
          "fontSize": "{primitive.fontSize.base}",
          "fontWeight": "{primitive.fontWeight.semibold}",
          "lineHeight": "{primitive.lineHeight.normal}",
          "color": "{semantic.color.foreground.secondary}"
        }
      },
      "caption": {
        "fontSize": "{primitive.fontSize.sm}",
        "fontWeight": "{primitive.fontWeight.normal}",
        "lineHeight": "{primitive.lineHeight.relaxed}",
        "color": "{semantic.color.foreground.muted}"
      }
    }
  },

  "component": {
    "button": {
      "primary": {
        "background": "{semantic.color.interactive.primary.default}",
        "color": "{semantic.color.foreground.primary}",
        "border": "1px solid {semantic.color.interactive.primary.default}",
        "borderRadius": "{primitive.borderRadius.md}",
        "fontSize": "{primitive.fontSize.md}",
        "fontWeight": "{primitive.fontWeight.bold}",
        "paddingX": "{primitive.spacing.3}",
        "paddingY": "{primitive.spacing.2}",
        "height": "44px",
        "cursor": "pointer",
        "transition": "all {primitive.transition.fast}",
        "states": {
          "hover": {
            "background": "{semantic.color.interactive.primary.hover}",
            "borderColor": "{semantic.color.interactive.primary.hover}"
          },
          "active": {
            "background": "{semantic.color.interactive.primary.active}",
            "borderColor": "{semantic.color.interactive.primary.active}"
          },
          "disabled": {
            "background": "{semantic.color.interactive.primary.disabled}",
            "borderColor": "{semantic.color.interactive.primary.disabled}",
            "cursor": "not-allowed",
            "opacity": "0.5"
          },
          "focus": {
            "outline": "none",
            "boxShadow": "{primitive.boxShadow.focus}"
          }
        }
      },
      "secondary": {
        "background": "{semantic.color.interactive.secondary.default}",
        "color": "{semantic.color.foreground.muted}",
        "border": "1px solid {semantic.color.border.default}",
        "borderRadius": "{primitive.borderRadius.md}",
        "fontSize": "{primitive.fontSize.md}",
        "fontWeight": "{primitive.fontWeight.semibold}",
        "paddingX": "{primitive.spacing.3}",
        "paddingY": "{primitive.spacing.2}",
        "height": "44px",
        "cursor": "pointer",
        "transition": "all {primitive.transition.fast}",
        "states": {
          "hover": {
            "background": "{semantic.color.interactive.secondary.hover}",
            "color": "{semantic.color.foreground.primary}"
          },
          "active": {
            "background": "{semantic.color.interactive.secondary.active}"
          }
        }
      },
      "destructive": {
        "background": "{semantic.color.interactive.destructive.default}",
        "color": "{semantic.color.foreground.primary}",
        "border": "1px solid {semantic.color.interactive.destructive.default}",
        "borderRadius": "{primitive.borderRadius.md}",
        "fontSize": "{primitive.fontSize.md}",
        "fontWeight": "{primitive.fontWeight.bold}",
        "paddingX": "{primitive.spacing.3}",
        "paddingY": "{primitive.spacing.2}",
        "height": "44px",
        "cursor": "pointer",
        "transition": "all {primitive.transition.fast}",
        "states": {
          "hover": {
            "background": "{semantic.color.interactive.destructive.hover}",
            "borderColor": "{semantic.color.interactive.destructive.hover}"
          }
        }
      }
    },
    "input": {
      "default": {
        "background": "{semantic.color.background.secondary}",
        "color": "{semantic.color.foreground.primary}",
        "border": "1px solid {semantic.color.border.default}",
        "borderRadius": "{primitive.borderRadius.md}",
        "fontSize": "{primitive.fontSize.md}",
        "paddingX": "{primitive.spacing.3}",
        "paddingY": "{primitive.spacing.2}",
        "height": "44px",
        "width": "100%",
        "transition": "border-color {primitive.transition.fast}, box-shadow {primitive.transition.fast}",
        "placeholder": {
          "color": "{semantic.color.foreground.muted}"
        },
        "states": {
          "focus": {
            "outline": "none",
            "borderColor": "{semantic.color.border.focus}",
            "boxShadow": "{primitive.boxShadow.focus}"
          },
          "disabled": {
            "background": "{semantic.color.background.tertiary}",
            "cursor": "not-allowed",
            "opacity": "0.5"
          }
        }
      }
    },
    "card": {
      "default": {
        "background": "{semantic.color.background.secondary}",
        "border": "1px solid {semantic.color.border.default}",
        "borderRadius": "{primitive.borderRadius.lg}",
        "padding": "{primitive.spacing.7}",
        "boxShadow": "{primitive.boxShadow.combined}"
      }
    },
    "status": {
      "success": {
        "background": "{semantic.color.status.success.bg}",
        "color": "{semantic.color.status.success.fg}",
        "border": "1px solid {semantic.color.status.success.border}",
        "borderRadius": "{primitive.borderRadius.md}",
        "padding": "{primitive.spacing.2} {primitive.spacing.3}",
        "fontSize": "{primitive.fontSize.base}",
        "lineHeight": "{primitive.lineHeight.normal}"
      },
      "error": {
        "background": "{semantic.color.status.error.bg}",
        "color": "{semantic.color.status.error.fg}",
        "border": "1px solid {semantic.color.status.error.border}",
        "borderRadius": "{primitive.borderRadius.md}",
        "padding": "{primitive.spacing.2} {primitive.spacing.3}",
        "fontSize": "{primitive.fontSize.base}",
        "lineHeight": "{primitive.lineHeight.normal}"
      }
    },
    "link": {
      "default": {
        "color": "{semantic.color.interactive.primary.default}",
        "textDecoration": "none",
        "fontWeight": "{primitive.fontWeight.semibold}",
        "fontSize": "{primitive.fontSize.base}",
        "transition": "color {primitive.transition.fast}"
      },
      "states": {
        "hover": {
          "color": "{primitive.color.orange.300}"
        }
      }
    }
  }
}
